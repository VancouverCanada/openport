# OpenPort product stack: example environment for local development.
# `npm run env:product` copies this file to `.env` (or appends missing keys).
# compose/docker-compose.yml loads the root `.env` into the reference-server,
# api, and web containers. Values below match the compose defaults.
# Never commit a real `.env`.

# Product API (apps/api)
HOST=0.0.0.0
PORT=4000

# Reference runtime (apps/reference-server).
# REFERENCE_HOST takes precedence over HOST; keep 0.0.0.0 so the container
# is reachable through the published port.
REFERENCE_HOST=0.0.0.0
REFERENCE_PORT=8080

# Domain adapter: `memory` (default) or `postgres`.
# With `postgres`, also set OPENPORT_DATABASE_URL (see README "Adapter mode").
OPENPORT_DOMAIN_ADAPTER=memory

# Web app (apps/web): browser-facing API base URL.
NEXT_PUBLIC_OPENPORT_API_BASE_URL=http://127.0.0.1:4100/api

# Postgres container (local development only; change the password).
POSTGRES_DB=openport
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Host ports published by compose (also used by `npm run health:product`).
REFERENCE_HOST_PORT=8080
API_HOST_PORT=4100
WEB_HOST_PORT=3100
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
